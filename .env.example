# helix-cortex Environment Variables Configuration

# Secret key used for signing and verifying JWT tokens (HMAC-SHA256, minimum 256 bits)
JWT_SECRET=super_secret_helix_cortex_jwt_signing_key_at_least_32_bytes_long!

# PostgreSQL database password for pulse user
DB_PASSWORD=cortex_secure_password_123

# Redis L4 distributed cache connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka streaming cluster bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ONNX Model Registry and Execution Session Pool Configuration
MODEL_STORE_PATH=/opt/helix/models
ONNX_POOL_MAX_SIZE=16
ONNX_POOL_MAX_WAIT_MS=500
